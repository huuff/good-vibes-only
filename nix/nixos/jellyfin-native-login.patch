diff --git a/src/system/SystemComponent.cpp b/src/system/SystemComponent.cpp
index 8f6183b..9aae0d5 100644
--- a/src/system/SystemComponent.cpp
+++ b/src/system/SystemComponent.cpp
@@ -567,6 +567,32 @@ QString SystemComponent::getNativeShellScript()
     }
   }
   clientData.insert("mode", QJsonValue::fromVariant(defaultMode));
+  QString serverUrl = qEnvironmentVariable("HMS_JELLYFIN_URL");
+  QString autoLoginUsername = qEnvironmentVariable("HMS_JELLYFIN_USERNAME");
+  QFile autoLoginPasswordFile(qEnvironmentVariable("HMS_JELLYFIN_PASSWORD_FILE"));
+  if (!serverUrl.isEmpty()) {
+    clientData.insert("hmsServerUrl", serverUrl);
+  }
+  bool autoLoginPasswordReadable = !autoLoginUsername.isEmpty()
+    && autoLoginPasswordFile.open(QIODevice::ReadOnly);
+  if (!serverUrl.isEmpty() || !autoLoginUsername.isEmpty()) {
+    qInfo() << "HMS bootstrap configured - server:" << !serverUrl.isEmpty()
+            << "auto-login:" << !autoLoginUsername.isEmpty()
+            << "password readable:" << autoLoginPasswordReadable;
+  }
+  if (autoLoginPasswordReadable) {
+    QString autoLoginPassword = QTextStream(&autoLoginPasswordFile).readAll();
+    while (autoLoginPassword.endsWith('\n') || autoLoginPassword.endsWith('\r')) {
+      autoLoginPassword.chop(1);
+    }
+    QJsonObject autoLogin;
+    autoLogin.insert("username", autoLoginUsername);
+    autoLogin.insert("password", autoLoginPassword);
+    clientData.insert("hmsAutoLogin", autoLogin);
+  }
+  qunsetenv("HMS_JELLYFIN_URL");
+  qunsetenv("HMS_JELLYFIN_USERNAME");
+  qunsetenv("HMS_JELLYFIN_PASSWORD_FILE");
 
   QVariantList settingsDescriptionsList = SettingsComponent::Get().settingDescriptions();
   QVariantMap settingsDescriptions = QVariantMap();
@@ -602,6 +628,9 @@ QString SystemComponent::getNativeShellScript()
   };
 
   cachedScript = jmpInfoDeclaration;
+  // Keep HMS bootstrap independent of failures in upstream extension scripts.
+  cachedScript += loadScript(":/web-client/extension/hmsAutoLogin.js") + "\n";
+
   for (const QString& scriptPath : scriptPaths) {
     cachedScript += loadScript(scriptPath) + "\n";
   }
