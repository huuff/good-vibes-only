+    assert_eq!(
+        response.file_path.as_path(),
+        tmp.path().join(PROJECT_TRUST_TOML_FILE)
+    );
+    let state = std::fs::read_to_string(tmp.path().join(PROJECT_TRUST_TOML_FILE))?;
+    assert!(state.contains("[hooks.state"));
+    assert!(state.contains("trusted_hash = \"sha256:trusted\""));
+    Ok(())
