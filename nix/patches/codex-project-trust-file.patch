+async fn batch_write_persists_hook_state_outside_config_toml() -> Result<()> {
+    let tmp = tempdir()?;
+    let config_path = tmp.path().join(CONFIG_TOML_FILE);
+    std::fs::write(&config_path, "model = \"gpt-declarative\"\n")?;
+    let service = ConfigManager::without_managed_config_for_tests(tmp.path().to_path_buf());
+
+    let response = service
+        .batch_write(ConfigBatchWriteParams {
+            edits: vec![codex_app_server_protocol::ConfigEdit {
+                key_path: "hooks.state".to_string(),
+                value: serde_json::json!({
+                    "plugin@test:hooks/hooks.json:session_start:0:0": {
+                        "trusted_hash": "sha256:trusted"
+                    }
+                }),
+                merge_strategy: MergeStrategy::Upsert,
+            }],
+            file_path: None,
+            expected_version: None,
+            reload_user_config: true,
+        })
+        .await?;
+
+    assert_eq!(
+        std::fs::read_to_string(config_path)?,
+        "model = \"gpt-declarative\"\n"
+    );
+    assert_eq!(
+        response.file_path.as_path(),
+        tmp.path().join(TRUST_TOML_FILE)
+    );
+    let state = std::fs::read_to_string(tmp.path().join(TRUST_TOML_FILE))?;
+    assert!(state.contains("[hooks.state"));
+    assert!(state.contains("trusted_hash = \"sha256:trusted\""));
+    Ok(())
