 struct TestFileSystem;

+#[tokio::test]
+async fn dedicated_project_trust_file_overrides_legacy_config() {
+    let tmp = tempdir().expect("tempdir");
+    let codex_home = tmp.path().join("codex-home");
+    let project = tmp.path().join("project");
+    std::fs::create_dir_all(&codex_home).expect("create codex home");
+    std::fs::create_dir_all(&project).expect("create project");
+    std::fs::write(project.join(".project-root"), "").expect("write project marker");
+    std::fs::create_dir_all(project.join(".codex")).expect("create project config directory");
+    std::fs::write(
+        project.join(".codex").join(CONFIG_TOML_FILE),
+        "model=\"project\"",
+    )
+    .expect("write project config");
+
+    let project_key = project_trust_key(&project);
+    let quoted_key = TomlValue::String(project_key).to_string();
+    std::fs::write(
+        codex_home.join(CONFIG_TOML_FILE),
+        format!(
+            "project_root_markers=[\".project-root\"]\n[projects.{quoted_key}]\ntrust_level=\"trusted\""
+        ),
+    )
+    .expect("write legacy config");
+    std::fs::write(
+        codex_home.join(crate::PROJECT_TRUST_TOML_FILE),
+        format!("[projects.{quoted_key}]\ntrust_level=\"untrusted\""),
+    )
+    .expect("write project trust state");
+
+    let cwd = AbsolutePathBuf::from_absolute_path(&project).expect("absolute cwd");
+    let stack = load_config_layers_state(
+        &TestFileSystem,
+        &codex_home,
+        Some(cwd),
+        &[],
+        LoaderOverrides::without_managed_config_for_tests(),
+        &crate::NoopThreadConfigLoader,
+    )
+    .await
+    .expect("load config layers");
+
+    let project_layer = stack
+        .all_layers_low_to_high()
+        .find(|layer| matches!(layer.name, ConfigLayerSource::Project { .. }))
+        .expect("project layer");
+    let disabled_reason = project_layer
+        .disabled_reason
+        .as_deref()
+        .expect("disabled reason");
+    assert!(disabled_reason.contains("marked as untrusted"));
+    assert!(disabled_reason.contains(crate::PROJECT_TRUST_TOML_FILE));
+}
