+#[test]
+fn test_set_project_trusted_writes_dedicated_state_file() -> anyhow::Result<()> {
+    let codex_home = tempfile::tempdir()?;
+    let project_dir = Path::new("/some/path");
+
+    set_project_trust_level(codex_home.path(), project_dir, TrustLevel::Trusted)?;
+
+    assert!(!codex_home.path().join(CONFIG_TOML_FILE).exists());
+    let contents = std::fs::read_to_string(
+        codex_home
+            .path()
+            .join(codex_config::PROJECT_TRUST_TOML_FILE),
+    )?;
+    assert!(contents.contains("trust_level = \"trusted\""));
+    assert!(contents.contains(&project_trust_key(project_dir)));
+
+    Ok(())
+}
